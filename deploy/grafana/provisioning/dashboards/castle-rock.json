{
  "uid": "castle-rock-dashboard",
  "title": "Castle Rock — Overview",
  "tags": ["castle-rock", "docker", "overview"],
  "editable": true,
  "graphTooltip": 2,
  "schemaVersion": 39,
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "10s",
  "annotations": { "list": [] },
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "📊 Visão Geral",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "id": 1,
      "title": "Containers Ativos",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus" },
      "targets": [
        { "expr": "count(castle_rock_container_info) or vector(0)", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "#22C55E", "value": null }] },
          "unit": "short"
        }
      },
      "options": { "colorMode": "background_solid", "graphMode": "none", "textMode": "value" }
    },
    {
      "type": "stat",
      "id": 2,
      "title": "CPU Média",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus" },
      "targets": [
        { "expr": "avg(castle_rock_container_cpu_percent) or vector(0)", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [
            { "color": "#22C55E", "value": null },
            { "color": "#F59E0B", "value": 50 },
            { "color": "#EF4444", "value": 80 }
          ]},
          "unit": "percent", "decimals": 1
        }
      },
      "options": { "colorMode": "background_solid", "graphMode": "area", "textMode": "value" }
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Memória Média",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus" },
      "targets": [
        { "expr": "avg(castle_rock_container_memory_percent) or vector(0)", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [
            { "color": "#22C55E", "value": null },
            { "color": "#F59E0B", "value": 60 },
            { "color": "#EF4444", "value": 85 }
          ]},
          "unit": "percent", "decimals": 1
        }
      },
      "options": { "colorMode": "background_solid", "graphMode": "area", "textMode": "value" }
    },
    {
      "type": "stat",
      "id": 4,
      "title": "RAM Total Usada",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus" },
      "targets": [
        { "expr": "sum(castle_rock_container_memory_usage_bytes) or vector(0)", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "#3B82F6", "value": null }] },
          "unit": "decbytes"
        }
      },
      "options": { "colorMode": "background_solid", "graphMode": "none", "textMode": "value" }
    },

    {
      "type": "row",
      "id": 101,
      "title": "📈 CPU & Memória",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "CPU % por Container",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus" },
      "targets": [
        { "expr": "castle_rock_container_cpu_percent", "legendFormat": "{{ container_name }}" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never" },
          "unit": "percent", "min": 0
        }
      }
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "Memória % por Container",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus" },
      "targets": [
        { "expr": "castle_rock_container_memory_percent", "legendFormat": "{{ container_name }}" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never" },
          "unit": "percent", "min": 0
        }
      }
    },

    {
      "type": "row",
      "id": 102,
      "title": "🌐 Rede & 💿 Disco",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }
    },
    {
      "type": "timeseries",
      "id": 20,
      "title": "Network I/O (RX ↓ / TX ↑)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus" },
      "targets": [
        { "expr": "sum(castle_rock_container_network_rx_bytes) by (container_name)", "legendFormat": "↓ {{ container_name }}" },
        { "expr": "sum(castle_rock_container_network_tx_bytes) by (container_name)", "legendFormat": "↑ {{ container_name }}" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never" },
          "unit": "decbytes"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 21,
      "title": "Disk I/O (Read / Write)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "datasource": { "type": "prometheus" },
      "targets": [
        { "expr": "sum(castle_rock_container_block_read_bytes) by (container_name)", "legendFormat": "Read {{ container_name }}" },
        { "expr": "sum(castle_rock_container_block_write_bytes) by (container_name)", "legendFormat": "Write {{ container_name }}" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never" },
          "unit": "decbytes"
        }
      }
    },

    {
      "type": "row",
      "id": 103,
      "title": "🚨 Top Consumidores",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }
    },
    {
      "type": "bargauge",
      "id": 30,
      "title": "Top CPU %",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus" },
      "targets": [
        { "expr": "topk(5, castle_rock_container_cpu_percent)", "instant": true, "legendFormat": "{{ container_name }}" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [
            { "color": "#22C55E", "value": null },
            { "color": "#F59E0B", "value": 50 },
            { "color": "#EF4444", "value": 80 }
          ]},
          "unit": "percent", "min": 0, "max": 100
        }
      },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true }
    },
    {
      "type": "bargauge",
      "id": 31,
      "title": "Top Memória %",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus" },
      "targets": [
        { "expr": "topk(5, castle_rock_container_memory_percent)", "instant": true, "legendFormat": "{{ container_name }}" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [
            { "color": "#22C55E", "value": null },
            { "color": "#F59E0B", "value": 60 },
            { "color": "#EF4444", "value": 85 }
          ]},
          "unit": "percent", "min": 0, "max": 100
        }
      },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true }
    },

    {
      "type": "row",
      "id": 104,
      "title": "📋 Inventário",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 }
    },
    {
      "type": "table",
      "id": 50,
      "title": "Containers Monitorados",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 31 },
      "datasource": { "type": "prometheus" },
      "targets": [
        { "expr": "castle_rock_container_info", "instant": true, "format": "table" }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Value": true, "__name__": true, "job": true, "instance": true, "env": true },
            "renameByName": {
              "container_name": "Container",
              "container_id": "ID",
              "image": "Imagem",
              "host_id": "Host"
            }
          }
        }
      ]
    }
  ]
}