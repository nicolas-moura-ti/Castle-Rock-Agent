{
  "uid": "castle-rock-detail",
  "title": "Castle Rock — Container Detail",
  "tags": ["castle-rock", "docker", "detail"],
  "editable": true,
  "graphTooltip": 2,
  "schemaVersion": 39,
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "5s",
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": { "type": "prometheus" },
        "definition": "label_values(castle_rock_container_info, container_name)",
        "query": "label_values(castle_rock_container_info, container_name)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "📊 $container — Resumo",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "gauge",
      "id": 1,
      "title": "CPU Atual",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus" },
      "targets": [
        { "expr": "castle_rock_container_cpu_percent{container_name=\"$container\"}", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [
            { "color": "#22C55E", "value": null },
            { "color": "#F59E0B", "value": 50 },
            { "color": "#EF4444", "value": 80 }
          ]},
          "unit": "percent", "min": 0, "max": 100
        }
      }
    },
    {
      "type": "gauge",
      "id": 2,
      "title": "Memória Atual",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus" },
      "targets": [
        { "expr": "castle_rock_container_memory_percent{container_name=\"$container\"}", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [
            { "color": "#22C55E", "value": null },
            { "color": "#F59E0B", "value": 60 },
            { "color": "#EF4444", "value": 85 }
          ]},
          "unit": "percent", "min": 0, "max": 100
        }
      }
    },
    {
      "type": "stat",
      "id": 3,
      "title": "RAM Usada",
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus" },
      "targets": [
        { "expr": "castle_rock_container_memory_usage_bytes{container_name=\"$container\"}", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "#3B82F6", "value": null }] },
          "unit": "decbytes"
        }
      },
      "options": { "colorMode": "background_solid", "graphMode": "none", "textMode": "value" }
    },
    {
      "type": "stat",
      "id": 4,
      "title": "RAM Limite",
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus" },
      "targets": [
        { "expr": "castle_rock_container_memory_limit_bytes{container_name=\"$container\"}", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "#6B7280", "value": null }] },
          "unit": "decbytes"
        }
      },
      "options": { "colorMode": "background_solid", "graphMode": "none", "textMode": "value" }
    },
    {
      "type": "stat",
      "id": 5,
      "title": "Network Total",
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus" },
      "targets": [
        { "expr": "castle_rock_container_network_rx_bytes{container_name=\"$container\"} + castle_rock_container_network_tx_bytes{container_name=\"$container\"}", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "#8B5CF6", "value": null }] },
          "unit": "decbytes"
        }
      },
      "options": { "colorMode": "background_solid", "graphMode": "none", "textMode": "value" }
    },

    {
      "type": "row",
      "id": 101,
      "title": "📈 CPU",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "CPU % — $container",
      "description": "Histórico de uso de CPU. Linhas horizontais: warning 50%, critical 80%.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus" },
      "targets": [
        { "expr": "castle_rock_container_cpu_percent{container_name=\"$container\"}", "legendFormat": "CPU %" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#3B82F6", "mode": "fixed" },
          "custom": { "fillOpacity": 15, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "thresholdsStyle": { "mode": "dashed" } },
          "unit": "percent", "min": 0,
          "thresholds": { "steps": [
            { "color": "transparent", "value": null },
            { "color": "#F59E0B", "value": 50 },
            { "color": "#EF4444", "value": 80 }
          ]}
        }
      }
    },

    {
      "type": "row",
      "id": 102,
      "title": "💾 Memória",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 }
    },
    {
      "type": "timeseries",
      "id": 20,
      "title": "Memória — Uso vs Limite",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus" },
      "targets": [
        { "expr": "castle_rock_container_memory_usage_bytes{container_name=\"$container\"}", "legendFormat": "Uso" },
        { "expr": "castle_rock_container_memory_limit_bytes{container_name=\"$container\"}", "legendFormat": "Limite" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never" },
          "unit": "decbytes"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Limite" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "color", "value": { "fixedColor": "#EF4444", "mode": "fixed" } }
            ]
          }
        ]
      }
    },

    {
      "type": "row",
      "id": 103,
      "title": "🌐 Rede & 💿 Disco",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 }
    },
    {
      "type": "timeseries",
      "id": 30,
      "title": "Network I/O — $container",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "datasource": { "type": "prometheus" },
      "targets": [
        { "expr": "castle_rock_container_network_rx_bytes{container_name=\"$container\"}", "legendFormat": "↓ Download (RX)" },
        { "expr": "castle_rock_container_network_tx_bytes{container_name=\"$container\"}", "legendFormat": "↑ Upload (TX)" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 15, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never" },
          "unit": "decbytes"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 40,
      "title": "Disk I/O — $container",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "datasource": { "type": "prometheus" },
      "targets": [
        { "expr": "castle_rock_container_block_read_bytes{container_name=\"$container\"}", "legendFormat": "Read" },
        { "expr": "castle_rock_container_block_write_bytes{container_name=\"$container\"}", "legendFormat": "Write" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 15, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never" },
          "unit": "decbytes"
        }
      }
    }
  ]
}