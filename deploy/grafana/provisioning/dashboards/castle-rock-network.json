            },
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 16,
                "y": 6
            },
            "id": 11,
            "title": "Download — Top Containers",
            "type": "bargauge",
            "targets": [
                {
                    "expr": "topk(10, castle_rock_container_network_rx_bytes)",
                    "legendFormat": "{{container_name}}",
                    "instant": true
                }
            ],
            "options": {
                "orientation": "horizontal",
                "displayMode": "gradient",
                "showUnfilled": true
            }
        },
