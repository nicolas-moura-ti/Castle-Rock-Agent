            "id": 4,
            "title": "Containers com Rede",
            "type": "stat",
            "targets": [
                {
                    "expr": "count(castle_rock_container_network_rx_bytes > 0)",
                    "instant": true
                }
            ],
            "options": {
                "colorMode": "background_solid",
                "graphMode": "none",
                "textMode": "value"
