                        ]
                    }
                }
            },
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 0,
                "y": 1
            },
            "id": 1,
            "title": "Total Download ↓",
            "type": "stat",
            "targets": [
                {
                    "expr": "sum(castle_rock_container_network_rx_bytes)",
                    "instant": true
                }
            ],
            "options": {
                "colorMode": "background_solid",
                "graphMode": "area",
                "textMode": "value"
            }
        },
        {
            "datasource": {
                "type": "prometheus"
            },
            "fieldConfig": {
