            "options": {
                "colorMode": "background_solid",
                "graphMode": "area",
                "textMode": "value"
            }
        },
        {
            "datasource": {
                "type": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
