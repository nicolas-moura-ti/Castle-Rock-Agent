            "type": "row"
        },
        {
            "datasource": {
                "type": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 25,
                        "showPoints": "never",
                        "lineInterpolation": "smooth",
                        "gradientMode": "scheme"
                    },
                    "unit": "decbytes"
                }
            },
            "gridPos": {
                "h": 8,
                "w": 16,
                "x": 0,
                "y": 6
            },
            "id": 10,
            "title": "Download (RX) — Time Series",
            "type": "timeseries",
            "targets": [
                {
                    "expr": "castle_rock_container_network_rx_bytes",
                    "legendFormat": "{{container_name}}"
                }
            ],
            "options": {
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            }
        },
        {
            "datasource": {
                "type": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "continuous-blues"
                    },
                    "custom": {
                        "fillOpacity": 80
                    },
                    "unit": "decbytes"
