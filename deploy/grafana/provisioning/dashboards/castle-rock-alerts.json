            },
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 0,
                "y": 1
            },
            "id": 1,
            "title": "Containers com CPU > 80%",
            "type": "stat",
            "targets": [
                {
                    "expr": "count(castle_rock_container_cpu_percent > 80) or vector(0)",
                    "instant": true
                }
            ],
            "options": {
                "colorMode": "background_solid",
                "graphMode": "none",
                "textMode": "value"
            }
        },
