                "w": 12,
                "x": 0,
                "y": 6
            },
            "id": 10,
            "title": "CPU % — Ranking (Maior → Menor)",
            "type": "bargauge",
            "targets": [
                {
                    "expr": "sort_desc(castle_rock_container_cpu_percent)",
                    "legendFormat": "{{container_name}}",
                    "instant": true
                }
            ],
            "options": {
                "orientation": "horizontal",
                "displayMode": "gradient",
                "showUnfilled": true
            }
        },
