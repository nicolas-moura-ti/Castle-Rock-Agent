        {
            "datasource": {
                "type": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "continuous-RdYlGr"
                    },
                    "custom": {
                        "fillOpacity": 80
                    },
                    "unit": "percent",
                    "min": 0,
                    "max": 100,
                    "thresholds": {
                        "steps": [
                            {
                                "color": "#22C55E",
                                "value": null
