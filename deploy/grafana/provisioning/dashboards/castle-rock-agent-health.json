{
    "annotations": {
        "list": []
    },
    "editable": true,
    "graphTooltip": 2,
    "panels": [
        {
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 0
            },
            "id": 100,
            "title": "🛡️ Status do Agente",
            "type": "row"
        },
        {
            "datasource": {
                "type": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "unit": "short",
                    "thresholds": {
                        "steps": [
                            {
                                "color": "#22C55E",
                                "value": null
                            }
                        ]
                    }
                }
            },
            "gridPos": {
                "h": 4,
                "w": 8,
                "x": 0,
                "y": 1
            },
            "id": 1,
            "title": "Containers Monitorados",
            "type": "stat",
            "targets": [
                {
                    "expr": "castle_rock_monitored_containers_count or vector(0)",
                    "instant": true
                }
            ],
            "options": {
                "colorMode": "background_solid",
                "graphMode": "area",
                "textMode": "value"
            }
        },
        {
            "datasource": {
                "type": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "unit": "percent",
                    "thresholds": {
                        "steps": [
                            {
                                "color": "#EF4444",
                                "value": null
                            },
                            {
                                "color": "#22C55E",
                                "value": 80
                            }
                        ]
                    }
                }
            },
            "gridPos": {
                "h": 4,
                "w": 8,
                "x": 8,
                "y": 1
            },
            "id": 2,
            "title": "Metadata Cache Hit Rate",
            "type": "stat",
            "targets": [
                {
                    "expr": "(rate(castle_rock_metadata_cache_hits_total[5m]) or vector(0)) / ((rate(castle_rock_metadata_cache_hits_total[5m]) or vector(0)) + (rate(castle_rock_metadata_cache_misses_total[5m]) or vector(0))) * 100",
                    "instant": true
                }
            ],
            "options": {
                "colorMode": "background_solid",
                "graphMode": "area",
                "textMode": "value"
            }
        },
        {
            "datasource": {
                "type": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "unit": "short",
                    "thresholds": {
                        "steps": [
                            {
                                "color": "#22C55E",
                                "value": null
                            },
                            {
                                "color": "#EF4444",
                                "value": 1
                            }
                        ]
                    }
                }
            },
            "gridPos": {
                "h": 4,
                "w": 8,
                "x": 16,
                "y": 1
            },
            "id": 3,
            "title": "Falhas no Cluster Push (5m)",
            "type": "stat",
            "targets": [
                {
                    "expr": "increase(castle_rock_cluster_push_failures_total[5m]) or vector(0)",
                    "instant": true
                }
            ],
            "options": {
                "colorMode": "background_solid",
                "graphMode": "area",
                "textMode": "value"
            }
        },
        {
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 5
            },
            "id": 101,
            "title": "⚡ Performance Interna",
            "type": "row"
        },
        {
            "datasource": {
                "type": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 15,
                        "showPoints": "never",
                        "lineInterpolation": "smooth"
                    },
                    "unit": "s"
                }
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 6
            },
            "id": 10,
            "title": "Latência Cluster Push (P99)",
            "type": "timeseries",
            "targets": [
                {
                    "expr": "histogram_quantile(0.99, sum by (le) (rate(castle_rock_cluster_push_duration_seconds_bucket[5m]))) or vector(0)",
                    "legendFormat": "p99 latency"
                }
            ]
        },
        {
            "datasource": {
                "type": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 15,
                        "showPoints": "never",
                        "lineInterpolation": "smooth"
                    },
                    "unit": "ops"
                }
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 6
            },
            "id": 11,
            "title": "Metadata Cache Activity",
            "type": "timeseries",
            "targets": [
                {
                    "expr": "rate(castle_rock_metadata_cache_hits_total[5m]) or vector(0)",
                    "legendFormat": "Hits"
                },
                {
                    "expr": "rate(castle_rock_metadata_cache_misses_total[5m]) or vector(0)",
                    "legendFormat": "Misses"
                }
            ]
        },
        {
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 14
            },
            "id": 102,
            "title": "🏗️ Recursos do Próprio Agente",
            "type": "row"
        },
        {
            "datasource": {
                "type": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 15,
                        "showPoints": "never",
                        "lineInterpolation": "smooth"
                    },
                    "unit": "percent",
                    "min": 0
                }
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 15
            },
            "id": 20,
            "title": "Agente — CPU %",
            "type": "timeseries",
            "targets": [
                {
                    "expr": "castle_rock_container_cpu_percent{container_name=~\"castle-rock-agent.*\"}",
                    "legendFormat": "Agent CPU"
                }
            ]
        },
        {
            "datasource": {
                "type": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 15,
                        "showPoints": "never",
                        "lineInterpolation": "smooth"
                    },
                    "unit": "decbytes"
                }
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 15
            },
            "id": 21,
            "title": "Agente — Memória Uso",
            "type": "timeseries",
            "targets": [
                {
                    "expr": "castle_rock_container_memory_usage_bytes{container_name=~\"castle-rock-agent.*\"}",
                    "legendFormat": "Agent RAM"
                }
            ]
        }
    ],
    "schemaVersion": 39,
    "tags": [
        "castle-rock",
        "self-monitoring",
        "agent"
    ],
    "time": {
        "from": "now-30m",
        "to": "now"
    },
    "refresh": "5s",
    "title": "Castle Rock — Agent Health (Created by Gemini CLI)",
    "uid": "castle-rock-agent-health-cli",
    "version": 1
}