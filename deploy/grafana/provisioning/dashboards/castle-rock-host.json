                    }
                }
            },
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 18,
                "y": 1
            },
            "id": 4,
            "title": "Carga Média RAM (Cluster)",
            "type": "stat",
            "targets": [
                {
                    "expr": "avg(castle_rock_container_memory_percent)",
                    "instant": true
                }
            ],
            "options": {
                "colorMode": "background_solid",
                "graphMode": "area",
                "textMode": "value"
            }
        },
        {
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 5
            },
            "id": 101,
            "title": "📈 Consumo Agregado por Host",
            "type": "row"
        },
        {
            "datasource": {
                "type": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 15,
                        "showPoints": "never",
                        "lineInterpolation": "smooth"
                    },
                    "unit": "percent"
                }
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 6
            },
            "id": 10,
            "title": "CPU % Consolidada por Host",
            "description": "Soma do uso de todos os containers em cada Host",
            "type": "timeseries",
            "targets": [
                {
                    "expr": "sum by (host_id) (castle_rock_container_cpu_percent)",
                    "legendFormat": "Host: {{host_id}}"
                }
            ]
        },
        {
            "datasource": {
                "type": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 15,
                        "showPoints": "never",
                        "lineInterpolation": "smooth"
                    },
                    "unit": "decbytes"
                }
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 6
            },
            "id": 11,
            "title": "RAM Consolidada por Host",
            "description": "Soma da memória usada por todos os containers em cada Host",
            "type": "timeseries",
            "targets": [
                {
                    "expr": "sum by (host_id) (castle_rock_container_memory_usage_bytes)",
                    "legendFormat": "Host: {{host_id}}"
                }
            ]
        },
        {
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 14
            },
            "id": 102,
            "title": "🌐 Rede e Disco por Host",
            "type": "row"
        },
        {
            "datasource": {
                "type": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 10,
                        "showPoints": "never",
                        "lineInterpolation": "smooth"
                    },
                    "unit": "Bps"
                }
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 15
            },
            "id": 20,
            "title": "Tráfego de Rede Total por Host",
            "type": "timeseries",
            "targets": [
                {
                    "expr": "sum by (host_id) (rate(castle_rock_container_network_rx_bytes[5m]) + rate(castle_rock_container_network_tx_bytes[5m]))",
                    "legendFormat": "Host: {{host_id}}"
                }
            ]
        },
        {
            "datasource": {
                "type": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 10,
                        "showPoints": "never",
                        "lineInterpolation": "smooth"
                    },
                    "unit": "Bps"
                }
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 15
            },
            "id": 21,
            "title": "Atividade de Disco Total por Host",
            "type": "timeseries",
            "targets": [
                {
                    "expr": "sum by (host_id) (rate(castle_rock_container_block_read_bytes[5m]) + rate(castle_rock_container_block_write_bytes[5m]))",
                    "legendFormat": "Host: {{host_id}}"
                }
            ]
        }
    ],
