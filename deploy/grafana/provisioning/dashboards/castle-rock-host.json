            "id": 100,
            "title": "🖥️ Resumo por Host",
            "type": "row"
        },
        {
            "datasource": {
                "type": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "unit": "short",
                    "thresholds": {
                        "steps": [
                            {
                                "color": "#22C55E",
                                "value": null
                            }
                        ]
                    }
                }
            },
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 0,
                "y": 1
            },
            "id": 1,
            "title": "Total de Hosts",
            "type": "stat",
            "targets": [
                {
                    "expr": "count(count by (host_id) (castle_rock_container_info))",
                    "instant": true
                }
            ],
            "options": {
                "colorMode": "background_solid",
                "graphMode": "none",
                "textMode": "value"
            }
        },
        {
            "datasource": {
                "type": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "unit": "short",
                    "thresholds": {
                        "steps": [
                            {
                                "color": "#06B6D4",
                                "value": null
                            }
                        ]
                    }
                }
            },
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 6,
                "y": 1
            },
            "id": 2,
            "title": "Total de Containers",
            "type": "stat",
            "targets": [
                {
                    "expr": "count(castle_rock_container_info)",
                    "instant": true
                }
            ],
            "options": {
                "colorMode": "background_solid",
                "graphMode": "none",
                "textMode": "value"
            }
        },
        {
            "datasource": {
                "type": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "unit": "percent",
                    "thresholds": {
                        "steps": [
                            {
                                "color": "#22C55E",
                                "value": null
                            },
                            {
                                "color": "#EAB308",
                                "value": 50
                            },
                            {
                                "color": "#EF4444",
                                "value": 80
                            }
                        ]
                    }
                }
            },
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 12,
                "y": 1
            },
            "id": 3,
            "title": "Carga Média CPU (Cluster)",
            "type": "stat",
            "targets": [
                {
                    "expr": "avg(castle_rock_container_cpu_percent)",
                    "instant": true
                }
            ],
            "options": {
                "colorMode": "background_solid",
                "graphMode": "area",
                "textMode": "value"
            }
        },
        {
            "datasource": {
                "type": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "unit": "percent",
                    "thresholds": {
                        "steps": [
                            {
                                "color": "#22C55E",
                                "value": null
                            },
                            {
                                "color": "#EAB308",
                                "value": 50
                            },
                            {
                                "color": "#EF4444",
                                "value": 85
                            }
